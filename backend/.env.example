# Copy to .env and fill in. NEVER commit the real .env.

# --- Core -------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins allowed to submit CSRF-protected forms/admin.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Defaults to local sqlite when unset. Example:
# DATABASE_URL=postgres://user:pass@localhost:5432/prcheck

# --- GitHub OAuth -----------------------------------------------------------
# Create an OAuth App: https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_OAUTH_REDIRECT_URI.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback/
GITHUB_OAUTH_SCOPE=read:user user:email

# --- CORS (frontend origins, comma-separated) -------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Code-review agent ------------------------------------------------------
# LLM backend: azure-ai-foundry | anthropic | openai-compatible | deterministic.
PRCHECK_LLM_BACKEND=azure-ai-foundry
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Azure AI Foundry Models (recommended; Qwen deployments use this path).
PRCHECK_AZURE_AI_FOUNDRY_API_KEY=
PRCHECK_AZURE_AI_FOUNDRY_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
PRCHECK_AZURE_AI_FOUNDRY_MODEL=YOUR-QWEN-DEPLOYMENT-NAME
PRCHECK_AZURE_AI_FOUNDRY_AUTH=api-key
# Generic OpenAI-compatible fallback / legacy Azure deployment-style settings:
PRCHECK_OPENAI_API_KEY=
PRCHECK_OPENAI_BASE_URL=https://api.openai.com/v1
PRCHECK_OPENAI_MODEL=gpt-4o
PRCHECK_OPENAI_API_VERSION=
# Read trusted review rules from the merge-base commit (.qwen/, AGENTS.md, etc.).
PRCHECK_REPO_GUIDANCE=True
PRCHECK_REPO_GUIDANCE_BYTES=24000
# Never report a clean PR as fully approved while external checks are failing/pending.
PRCHECK_CI_GATE_APPROVAL=True
# GitHub access for reading PRs. Prefer a GitHub App (reviewer posts as the bot);
# a PAT is the fallback when the App is not configured.
PRCHECK_GITHUB_TOKEN=
PRCHECK_PUBLISH_REVIEWS=False
# Inline comments per run, and the lowest severity posted inline (lower ones
# stay in the summary comment only):
PRCHECK_MAX_INLINE_COMMENTS=15
PRCHECK_INLINE_MIN_SEVERITY=medium
# Extra globs to skip (lockfiles, generated and vendored code are built in):
# PRCHECK_REVIEW_IGNORE_GLOBS=migrations/*,*.gen.ts
# GitHub App (preferred): app id + private key. The key may be given raw, as a
# file path (local dev), or base64 (prod, avoids env-var newline issues).
PRCHECK_GITHUB_APP_ID=
PRCHECK_GITHUB_APP_PRIVATE_KEY_PATH=infra/github_app_key.pem
# PRCHECK_GITHUB_APP_PRIVATE_KEY_B64=
# Verify GitHub webhook deliveries (set the same secret in the GitHub webhook):
PRCHECK_GITHUB_WEBHOOK_SECRET=
# Second-pass adversarial verifier (raises quality; extra model call):
PRCHECK_ENABLE_ADVERSARY=True
# Review mode: "fast" (single/size-sharded, precision-tuned) or "deep"
# (per-file issue-list generate + verify — higher recall, more model calls).
PRCHECK_REVIEW_MODE=fast
PRCHECK_DEEP_VERIFY=True
PRCHECK_DEEP_MAX_FILES=40
PRCHECK_DEEP_MIN_CONFIDENCE=0.3
PRCHECK_DEEP_FILE_BYTES=60000
PRCHECK_DEEP_RELATED_DEFINITIONS=True
PRCHECK_DEEP_MAX_RELATED_DEFINITIONS=12
PRCHECK_DEEP_RELATED_DEFINITION_BYTES=16000

# --- Cookie / TLS hardening (used when DJANGO_DEBUG=False) -------------------
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Strict
# Set to your apex/subdomain to share the refresh cookie, else leave blank.
AUTH_COOKIE_DOMAIN=
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
